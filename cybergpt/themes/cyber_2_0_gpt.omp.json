{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "CYBER 2.0 // {{.PWD}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#00E5FF",
          "template": "CYBER 2.0 // "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#64FF9B",
          "options": {
            "style": "full"
          },
          "template": "{{ .Path }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#FFD166",
          "template": "   {{ .HEAD }}{{ if .Working.Changed }} <#FF5FD2>{{ .Working.String }}</>{{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#62E7FF",
          "options": {
            "threshold": 500
          },
          "template": "  {{ .FormattedMs }}"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#64FF9B",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#FF5FD2{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": " ❯ "
        }
      ]
    }
  ]
}
